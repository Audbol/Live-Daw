# The Rust engine (rust/) is not built with -Zsanitizer=thread in the C++ sanitizer
# jobs, so TSan cannot see the Rust atomics that order its threads: it only sees
# intercepted memcpy/memset/malloc calls made from Rust and reports them as races.
# The Rust engine is checked under its own ThreadSanitizer run (CI job "Rust TSan").
race:livedaw_engine
race:livedaw_dsp
race:livedaw_ffi
race:livedaw_session
race:livedaw_recorder
race:livedaw_wing
# Rust's precompiled standard library has no frame pointers, so TSan's stacks can
# stop inside it (e.g. at String::clone) before reaching our crates' frames. Match
# those frames by their source paths, which only Rust code has.
race:library/alloc/src/
race:library/core/src/
race:library/std/src/
